{
  "entities": {
    "AppViewOptions": {
      "title": "AppViewOptions",
      "description": "Device-scoped non-PII UI theme and language preferences so the Login View opens with saved display options.",
      "type": "object",
      "properties": {
        "clientId": {
          "type": "string",
          "description": "Opaque client installation identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "language": {
          "type": "string",
          "description": "Saved UI language code.",
          "enum": ["en", "ar"],
          "maxLength": 8
        },
        "theme": {
          "type": "string",
          "description": "Saved UI theme mode.",
          "enum": ["light", "dark"],
          "maxLength": 16
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-updated timestamp."
        }
      },
      "required": ["clientId", "language", "theme", "createdAt", "updatedAt"]
    },
    "AccountIndexEntry": {
      "title": "AccountIndexEntry",
      "description": "Non-PII SHA-256 email hash directory entry verified before login to ensure the account exists in Firestore.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the registered account.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "status": {
          "type": "string",
          "description": "Account registration status.",
          "enum": ["active"],
          "maxLength": 16
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "status", "createdAt", "updatedAt"]
    },
    "UserAccountRoot": {
      "title": "UserAccountRoot",
      "description": "Root account document storing user ownership, account status, and physical biometrics.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the account owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "status": {
          "type": "string",
          "description": "Account status.",
          "enum": ["active"],
          "maxLength": 16
        },
        "heightCm": {
          "type": "number",
          "description": "User height/length in centimeters (100 to 250)."
        },
        "targetWeightKg": {
          "type": "number",
          "description": "Optional target body weight in kilograms."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-updated timestamp."
        }
      },
      "required": ["ownerId", "status", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII document storing user email and display name.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Account email address.",
          "minLength": 3,
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "description": "Display name.",
          "minLength": 1,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "email", "displayName", "createdAt", "updatedAt"]
    },
    "UserViewSettings": {
      "title": "UserViewSettings",
      "description": "Structured user training and display view preferences (theme, language, units, goal).",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "goal": {
          "type": "string",
          "enum": ["strength", "hypertrophy", "fat_loss", "endurance", "general"],
          "maxLength": 32
        },
        "preferredUnit": {
          "type": "string",
          "enum": ["kg", "lbs"],
          "maxLength": 8
        },
        "language": {
          "type": "string",
          "enum": ["en", "ar"],
          "maxLength": 8
        },
        "theme": {
          "type": "string",
          "enum": ["light", "dark"],
          "maxLength": 16
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "goal", "preferredUnit", "language", "theme", "createdAt", "updatedAt"]
    },
    "UserStatsSummary": {
      "title": "UserStatsSummary",
      "description": "Aggregated training volume, session counts, and latest body weight metrics for quick analytics.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "totalWorkouts": {
          "type": "number"
        },
        "totalVolumeKg": {
          "type": "number"
        },
        "totalCompletedSets": {
          "type": "number"
        },
        "latestWeightKg": {
          "type": "number"
        },
        "latestMeasurementDate": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "totalWorkouts", "totalVolumeKg", "totalCompletedSets", "createdAt", "updatedAt"]
    },
    "CustomExercise": {
      "title": "CustomExercise",
      "description": "User-created custom exercise definition.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "nameEn": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "nameAr": {
          "type": "string",
          "maxLength": 100
        },
        "muscleGroup": {
          "type": "string",
          "enum": ["chest", "back", "legs", "shoulders", "arms", "core", "full_body"],
          "maxLength": 24
        },
        "equipment": {
          "type": "string",
          "enum": ["barbell", "dumbbell", "machine", "cable", "bodyweight", "kettlebell", "other"],
          "maxLength": 24
        },
        "trackingType": {
          "type": "string",
          "enum": ["weight_reps", "bodyweight_reps", "duration"],
          "maxLength": 24
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "nameEn", "muscleGroup", "equipment", "trackingType", "createdAt", "updatedAt"]
    },
    "WorkoutRoutine": {
      "title": "WorkoutRoutine",
      "description": "Personalized workout routine template with target sets, reps, and rest timers.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "goal": {
          "type": "string",
          "enum": ["strength", "hypertrophy", "fat_loss", "endurance", "general"],
          "maxLength": 32
        },
        "estimatedMinutes": {
          "type": "number"
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "exercises": {
          "type": "array",
          "description": "Bounded list (max 30) of prescribed exercise entries."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "name", "goal", "estimatedMinutes", "exercises", "createdAt", "updatedAt"]
    },
    "WorkoutSession": {
      "title": "WorkoutSession",
      "description": "Completed workout log with sets, reps, load, and computed volume.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "routineId": {
          "type": "string",
          "maxLength": 128
        },
        "startedAtIso": {
          "type": "string",
          "minLength": 10,
          "maxLength": 40
        },
        "completedAtIso": {
          "type": "string",
          "minLength": 10,
          "maxLength": 40
        },
        "durationMinutes": {
          "type": "number"
        },
        "totalVolumeKg": {
          "type": "number"
        },
        "completedSetsCount": {
          "type": "number"
        },
        "notes": {
          "type": "string",
          "maxLength": 800
        },
        "entries": {
          "type": "array",
          "description": "Bounded list (max 30) of logged exercises and sets."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "title",
        "startedAtIso",
        "completedAtIso",
        "durationMinutes",
        "totalVolumeKg",
        "completedSetsCount",
        "entries",
        "createdAt",
        "updatedAt"
      ]
    },
    "BodyMeasurement": {
      "title": "BodyMeasurement",
      "description": "Body weight and anthropometric measurement record.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "recordedDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "weightKg": {
          "type": "number"
        },
        "bodyFatPct": {
          "type": "number"
        },
        "chestCm": {
          "type": "number"
        },
        "waistCm": {
          "type": "number"
        },
        "hipsCm": {
          "type": "number"
        },
        "armsCm": {
          "type": "number"
        },
        "thighsCm": {
          "type": "number"
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "recordedDate", "weightKg", "createdAt", "updatedAt"]
    },
    "ProgressReport": {
      "title": "ProgressReport",
      "description": "Saved progress report snapshot summarizing workouts, volume, and body weight trend.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "timeframeLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "startDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "endDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "workoutsCount": {
          "type": "number"
        },
        "totalVolumeKg": {
          "type": "number"
        },
        "weightDeltaKg": {
          "type": "number"
        },
        "topMuscleGroup": {
          "type": "string",
          "maxLength": 32
        },
        "notes": {
          "type": "string",
          "maxLength": 800
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "title",
        "timeframeLabel",
        "startDate",
        "endDate",
        "workoutsCount",
        "totalVolumeKg",
        "weightDeltaKg",
        "topMuscleGroup",
        "createdAt",
        "updatedAt"
      ]
    },
    "ExerciseGuideRecord": {
      "title": "ExerciseGuideRecord",
      "description": "Saved human anatomy muscle targets, recommended gym machines, and Gemini setup guide for an exercise.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "exerciseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "exerciseName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "primaryMuscles": {
          "type": "array",
          "description": "Bounded list (max 8) of targeted human anatomy muscle IDs."
        },
        "secondaryMuscles": {
          "type": "array",
          "description": "Bounded list (max 8) of secondary muscle IDs."
        },
        "recommendedMachines": {
          "type": "array",
          "description": "Bounded list (max 6) of recommended gym machine setup objects."
        },
        "howToUseSteps": {
          "type": "array",
          "description": "Bounded list (max 10) of setup & execution steps."
        },
        "commonMistakes": {
          "type": "array",
          "description": "Bounded list (max 8) of mistakes to avoid."
        },
        "coachingSummary": {
          "type": "string",
          "maxLength": 1200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "exerciseId",
        "exerciseName",
        "primaryMuscles",
        "secondaryMuscles",
        "recommendedMachines",
        "howToUseSteps",
        "commonMistakes",
        "coachingSummary",
        "createdAt",
        "updatedAt"
      ]
    },
    "MealLogEntry": {
      "title": "MealLogEntry",
      "description": "Daily food intake entry with calculated calories and macronutrients (without raw binary image payloads).",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "loggedDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "mealType": {
          "type": "string",
          "enum": ["breakfast", "lunch", "dinner", "snack"],
          "maxLength": 24
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "sourceMode": {
          "type": "string",
          "enum": ["text", "image", "manual"],
          "maxLength": 16
        },
        "totalCalories": {
          "type": "number"
        },
        "proteinG": {
          "type": "number"
        },
        "carbsG": {
          "type": "number"
        },
        "fatG": {
          "type": "number"
        },
        "fiberG": {
          "type": "number"
        },
        "items": {
          "type": "array",
          "description": "Bounded list (max 20) of parsed food items."
        },
        "nutritionNote": {
          "type": "string",
          "maxLength": 600
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "loggedDate",
        "mealType",
        "title",
        "sourceMode",
        "totalCalories",
        "proteinG",
        "carbsG",
        "fatG",
        "items",
        "createdAt",
        "updatedAt"
      ]
    },
    "PantryFoodItem": {
      "title": "PantryFoodItem",
      "description": "Food item currently available in the user's kitchen/pantry for weekly meal planning.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "category": {
          "type": "string",
          "enum": ["protein", "carbs", "fats", "produce", "dairy", "other"],
          "maxLength": 24
        },
        "quantityHint": {
          "type": "string",
          "maxLength": 60
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "name", "category", "createdAt", "updatedAt"]
    },
    "WeeklyMealPlan": {
      "title": "WeeklyMealPlan",
      "description": "Gemini-generated 7-day weekly meal plan tailored to the user's available foods and daily calorie target.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "goal": {
          "type": "string",
          "enum": ["strength", "hypertrophy", "fat_loss", "endurance", "general"],
          "maxLength": 32
        },
        "dailyTargetCalories": {
          "type": "number"
        },
        "language": {
          "type": "string",
          "enum": ["en", "ar"],
          "maxLength": 8
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        },
        "days": {
          "type": "array",
          "description": "Bounded list (exactly 1 to 7) of structured day meal plans."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "title", "goal", "dailyTargetCalories", "language", "days", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/appOptions/{clientId}": {
      "schema": { "$ref": "#/entities/AppViewOptions" },
      "description": "Saved theme and language view options loaded when opening the Login View."
    },
    "/accountIndex/{emailHash}": {
      "schema": { "$ref": "#/entities/AccountIndexEntry" },
      "description": "Non-PII email-hash lookup verified before sign-in."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccountRoot" },
      "description": "User account root document with status and body profile metrics."
    },
    "/users/{userId}/private/{infoId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated PII document (info) strictly restricted to the owning user."
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": { "$ref": "#/entities/UserViewSettings" },
      "description": "Structured user UI and training preferences (preferences document)."
    },
    "/users/{userId}/stats/{statId}": {
      "schema": { "$ref": "#/entities/UserStatsSummary" },
      "description": "Aggregated training statistics summary (summary document)."
    },
    "/users/{userId}/exercises/{exerciseId}": {
      "schema": { "$ref": "#/entities/CustomExercise" },
      "description": "Custom exercises authored by the user."
    },
    "/users/{userId}/exerciseGuides/{guideId}": {
      "schema": { "$ref": "#/entities/ExerciseGuideRecord" },
      "description": "Saved human muscle target & gym machine guides generated for exercises."
    },
    "/users/{userId}/routines/{routineId}": {
      "schema": { "$ref": "#/entities/WorkoutRoutine" },
      "description": "Personalized workout routines."
    },
    "/users/{userId}/workouts/{workoutId}": {
      "schema": { "$ref": "#/entities/WorkoutSession" },
      "description": "Completed workout logs."
    },
    "/users/{userId}/measurements/{measurementId}": {
      "schema": { "$ref": "#/entities/BodyMeasurement" },
      "description": "Weight and body measurements history."
    },
    "/users/{userId}/progressReports/{reportId}": {
      "schema": { "$ref": "#/entities/ProgressReport" },
      "description": "Saved progress report snapshots."
    },
    "/users/{userId}/mealLogs/{mealId}": {
      "schema": { "$ref": "#/entities/MealLogEntry" },
      "description": "Daily logged meals and calculated calories/macros."
    },
    "/users/{userId}/pantryItems/{itemId}": {
      "schema": { "$ref": "#/entities/PantryFoodItem" },
      "description": "Available foods in the user's pantry."
    },
    "/users/{userId}/mealPlans/{planId}": {
      "schema": { "$ref": "#/entities/WeeklyMealPlan" },
      "description": "Generated 7-day weekly meal plans based on pantry items."
    }
  }
}
