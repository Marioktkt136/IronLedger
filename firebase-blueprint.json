{
  "entities": {
    "AppViewOptions": {
      "title": "AppViewOptions",
      "description": "Device-scoped non-PII UI theme and language preferences so the Login View opens with saved display options.",
      "type": "object",
      "properties": {
        "clientId": {
          "type": "string",
          "description": "Opaque client installation identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "language": {
          "type": "string",
          "description": "Saved UI language code.",
          "enum": ["en", "ar"],
          "maxLength": 8
        },
        "theme": {
          "type": "string",
          "description": "Saved UI theme mode.",
          "enum": ["light", "dark"],
          "maxLength": 16
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-updated timestamp."
        }
      },
      "required": ["clientId", "language", "theme", "createdAt", "updatedAt"]
    },
    "AccountIndexEntry": {
      "title": "AccountIndexEntry",
      "description": "Non-PII SHA-256 email hash directory entry verified before login to ensure the account exists in Firestore.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the registered account.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "status": {
          "type": "string",
          "description": "Account registration status.",
          "enum": ["active"],
          "maxLength": 16
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "status", "createdAt", "updatedAt"]
    },
    "UserAccountRoot": {
      "title": "UserAccountRoot",
      "description": "Root account document storing user ownership, account status, and physical biometrics.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the account owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "status": {
          "type": "string",
          "description": "Account status.",
          "enum": ["active"],
          "maxLength": 16
        },
        "heightCm": {
          "type": "number",
          "description": "User height/length in centimeters (100 to 250)."
        },
        "targetWeightKg": {
          "type": "number",
          "description": "Optional target body weight in kilograms."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-updated timestamp."
        }
      },
      "required": ["ownerId", "status", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII document storing user email and display name.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Account email address.",
          "minLength": 3,
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "description": "Display name.",
          "minLength": 1,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "email", "displayName", "createdAt", "updatedAt"]
    },
    "UserViewSettings": {
      "title": "UserViewSettings",
      "description": "Structured user training and display view preferences (theme, language, units, goal).",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "goal": {
          "type": "string",
          "enum": ["strength", "hypertrophy", "fat_loss", "endurance", "general"],
          "maxLength": 32
        },
        "preferredUnit": {
          "type": "string",
          "enum": ["kg", "lbs"],
          "maxLength": 8
        },
        "language": {
          "type": "string",
          "enum": ["en", "ar"],
          "maxLength": 8
        },
        "theme": {
          "type": "string",
          "enum": ["light", "dark"],
          "maxLength": 16
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "goal", "preferredUnit", "language", "theme", "createdAt", "updatedAt"]
    },
    "UserStatsSummary": {
      "title": "UserStatsSummary",
      "description": "Aggregated training volume, session counts, and latest body weight metrics for quick analytics.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "totalWorkouts": {
          "type": "number"
        },
        "totalVolumeKg": {
          "type": "number"
        },
        "totalCompletedSets": {
          "type": "number"
        },
        "latestWeightKg": {
          "type": "number"
        },
        "latestMeasurementDate": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "totalWorkouts", "totalVolumeKg", "totalCompletedSets", "createdAt", "updatedAt"]
    },
    "CustomExercise": {
      "title": "CustomExercise",
      "description": "User-created custom exercise definition.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "nameEn": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "nameAr": {
          "type": "string",
          "maxLength": 100
        },
        "muscleGroup": {
          "type": "string",
          "enum": ["chest", "back", "legs", "shoulders", "arms", "core", "full_body"],
          "maxLength": 24
        },
        "equipment": {
          "type": "string",
          "enum": ["barbell", "dumbbell", "machine", "cable", "bodyweight", "kettlebell", "other"],
          "maxLength": 24
        },
        "trackingType": {
          "type": "string",
          "enum": ["weight_reps", "bodyweight_reps", "duration"],
          "maxLength": 24
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "nameEn", "muscleGroup", "equipment", "trackingType", "createdAt", "updatedAt"]
    },
    "WorkoutRoutine": {
      "title": "WorkoutRoutine",
      "description": "Personalized workout routine template with target sets, reps, and rest timers.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "goal": {
          "type": "string",
          "enum": ["strength", "hypertrophy", "fat_loss", "endurance", "general"],
          "maxLength": 32
        },
        "estimatedMinutes": {
          "type": "number"
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "exercises": {
          "type": "array",
          "description": "Bounded list (max 30) of prescribed exercise entries."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "name", "goal", "estimatedMinutes", "exercises", "createdAt", "updatedAt"]
    },
    "WorkoutSession": {
      "title": "WorkoutSession",
      "description": "Completed workout log with sets, reps, load, and computed volume.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "routineId": {
          "type": "string",
          "maxLength": 128
        },
        "startedAtIso": {
          "type": "string",
          "minLength": 10,
          "maxLength": 40
        },
        "completedAtIso": {
          "type": "string",
          "minLength": 10,
          "maxLength": 40
        },
        "durationMinutes": {
          "type": "number"
        },
        "totalVolumeKg": {
          "type": "number"
        },
        "completedSetsCount": {
          "type": "number"
        },
        "notes": {
          "type": "string",
          "maxLength": 800
        },
        "entries": {
          "type": "array",
          "description": "Bounded list (max 30) of logged exercises and sets."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "title",
        "startedAtIso",
        "completedAtIso",
        "durationMinutes",
        "totalVolumeKg",
        "completedSetsCount",
        "entries",
        "createdAt",
        "updatedAt"
      ]
    },
    "BodyMeasurement": {
      "title": "BodyMeasurement",
      "description": "Body weight and anthropometric measurement record.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "recordedDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "weightKg": {
          "type": "number"
        },
        "bodyFatPct": {
          "type": "number"
        },
        "chestCm": {
          "type": "number"
        },
        "waistCm": {
          "type": "number"
        },
        "hipsCm": {
          "type": "number"
        },
        "armsCm": {
          "type": "number"
        },
        "thighsCm": {
          "type": "number"
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "recordedDate", "weightKg", "createdAt", "updatedAt"]
    },
    "ProgressReport": {
      "title": "ProgressReport",
      "description": "Saved progress report snapshot summarizing workouts, volume, and body weight trend.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "timeframeLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "startDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "endDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "workoutsCount": {
          "type": "number"
        },
        "totalVolumeKg": {
          "type": "number"
        },
        "weightDeltaKg": {
          "type": "number"
        },
        "topMuscleGroup": {
          "type": "string",
          "maxLength": 32
        },
        "notes": {
          "type": "string",
          "maxLength": 800
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "title",
        "timeframeLabel",
        "startDate",
        "endDate",
        "workoutsCount",
        "totalVolumeKg",
        "weightDeltaKg",
        "topMuscleGroup",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/appOptions/{clientId}": {
      "schema": { "$ref": "#/entities/AppViewOptions" },
      "description": "Saved theme and language view options loaded when opening the Login View."
    },
    "/accountIndex/{emailHash}": {
      "schema": { "$ref": "#/entities/AccountIndexEntry" },
      "description": "Non-PII email-hash lookup verified before sign-in."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccountRoot" },
      "description": "User account root document with status and body profile metrics."
    },
    "/users/{userId}/private/{infoId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated PII document (info) strictly restricted to the owning user."
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": { "$ref": "#/entities/UserViewSettings" },
      "description": "Structured user UI and training preferences (preferences document)."
    },
    "/users/{userId}/stats/{statId}": {
      "schema": { "$ref": "#/entities/UserStatsSummary" },
      "description": "Aggregated training statistics summary (summary document)."
    },
    "/users/{userId}/exercises/{exerciseId}": {
      "schema": { "$ref": "#/entities/CustomExercise" },
      "description": "Custom exercises authored by the user."
    },
    "/users/{userId}/routines/{routineId}": {
      "schema": { "$ref": "#/entities/WorkoutRoutine" },
      "description": "Personalized workout routines."
    },
    "/users/{userId}/workouts/{workoutId}": {
      "schema": { "$ref": "#/entities/WorkoutSession" },
      "description": "Completed workout logs."
    },
    "/users/{userId}/measurements/{measurementId}": {
      "schema": { "$ref": "#/entities/BodyMeasurement" },
      "description": "Weight and body measurements history."
    },
    "/users/{userId}/progressReports/{reportId}": {
      "schema": { "$ref": "#/entities/ProgressReport" },
      "description": "Saved progress report snapshots."
    }
  }
}
