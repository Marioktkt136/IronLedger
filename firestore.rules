rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidEmailHash(hashId) {
      return hashId is string && hashId.size() == 64 && hashId.matches('^[a-f0-9]{64}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidOptionalNumber(data, key, minVal, maxVal) {
      return !(key in data) || (data[key] is number && data[key] >= minVal && data[key] <= maxVal);
    }

    function isValidOptionalString(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    function isValidOptionalDate(data, key) {
      return !(key in data) || (data[key] is string && data[key].size() == 10 && data[key].matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    function hasValidParentProfile(userId) {
      return existsAfter(/databases/$(database)/documents/users/$(userId))
        && getAfter(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;
    }

    // Entity Validators
    function isValidAppViewOptions(data, clientId) {
      return data.keys().hasAll(['clientId', 'language', 'theme', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['clientId', 'language', 'theme', 'createdAt', 'updatedAt'])
        && isValidId(data.clientId)
        && data.clientId == clientId
        && data.language is string && data.language.size() <= 8
        && data.language in ['en', 'ar']
        && data.theme is string && data.theme.size() <= 16
        && data.theme in ['light', 'dark']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAccountIndexEntry(data) {
      return data.keys().hasAll(['ownerId', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.status is string && data.status == 'active'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserAccountRoot(data, userId) {
      return data.keys().hasAll(['ownerId', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'status', 'heightCm', 'targetWeightKg', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.status is string && data.status == 'active'
        && isValidOptionalNumber(data, 'heightCm', 100, 250)
        && isValidOptionalNumber(data, 'targetWeightKg', 20, 400)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['ownerId', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserViewSettings(data, userId) {
      return data.keys().hasAll(['ownerId', 'goal', 'preferredUnit', 'language', 'theme', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'goal', 'preferredUnit', 'language', 'theme', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.goal is string && data.goal.size() <= 32
        && data.goal in ['strength', 'hypertrophy', 'fat_loss', 'endurance', 'general']
        && data.preferredUnit is string && data.preferredUnit.size() <= 8
        && data.preferredUnit in ['kg', 'lbs']
        && data.language is string && data.language.size() <= 8
        && data.language in ['en', 'ar']
        && data.theme is string && data.theme.size() <= 16
        && data.theme in ['light', 'dark']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserStatsSummary(data, userId) {
      return data.keys().hasAll(['ownerId', 'totalWorkouts', 'totalVolumeKg', 'totalCompletedSets', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'ownerId', 'totalWorkouts', 'totalVolumeKg', 'totalCompletedSets',
          'latestWeightKg', 'latestMeasurementDate', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.totalWorkouts is number && data.totalWorkouts >= 0 && data.totalWorkouts <= 100000
        && data.totalVolumeKg is number && data.totalVolumeKg >= 0 && data.totalVolumeKg <= 100000000
        && data.totalCompletedSets is number && data.totalCompletedSets >= 0 && data.totalCompletedSets <= 1000000
        && isValidOptionalNumber(data, 'latestWeightKg', 20, 400)
        && isValidOptionalDate(data, 'latestMeasurementDate')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCustomExercise(data, userId) {
      return data.keys().hasAll(['ownerId', 'nameEn', 'muscleGroup', 'equipment', 'trackingType', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'nameEn', 'nameAr', 'muscleGroup', 'equipment', 'trackingType', 'notes', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.nameEn is string && data.nameEn.size() >= 2 && data.nameEn.size() <= 100
        && isValidOptionalString(data, 'nameAr', 100)
        && data.muscleGroup is string && data.muscleGroup.size() <= 24
        && data.muscleGroup in ['chest', 'back', 'legs', 'shoulders', 'arms', 'core', 'full_body']
        && data.equipment is string && data.equipment.size() <= 24
        && data.equipment in ['barbell', 'dumbbell', 'machine', 'cable', 'bodyweight', 'kettlebell', 'other']
        && data.trackingType is string && data.trackingType.size() <= 24
        && data.trackingType in ['weight_reps', 'bodyweight_reps', 'duration']
        && isValidOptionalString(data, 'notes', 500)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWorkoutRoutine(data, userId) {
      return data.keys().hasAll(['ownerId', 'name', 'goal', 'estimatedMinutes', 'exercises', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'name', 'goal', 'estimatedMinutes', 'notes', 'exercises', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.goal is string && data.goal.size() <= 32
        && data.goal in ['strength', 'hypertrophy', 'fat_loss', 'endurance', 'general']
        && data.estimatedMinutes is number && data.estimatedMinutes >= 5 && data.estimatedMinutes <= 300
        && isValidOptionalString(data, 'notes', 500)
        && data.exercises is list && data.exercises.size() <= 30
        && (data.exercises.size() == 0 || data.exercises[0] is map)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWorkoutSession(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'title', 'startedAtIso', 'completedAtIso',
          'durationMinutes', 'totalVolumeKg', 'completedSetsCount', 'entries',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'title', 'routineId', 'startedAtIso', 'completedAtIso',
          'durationMinutes', 'totalVolumeKg', 'completedSetsCount', 'notes', 'entries',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 120
        && isValidOptionalString(data, 'routineId', 128)
        && data.startedAtIso is string && data.startedAtIso.size() >= 10 && data.startedAtIso.size() <= 40
        && data.completedAtIso is string && data.completedAtIso.size() >= 10 && data.completedAtIso.size() <= 40
        && data.durationMinutes is number && data.durationMinutes >= 1 && data.durationMinutes <= 480
        && data.totalVolumeKg is number && data.totalVolumeKg >= 0 && data.totalVolumeKg <= 250000
        && data.completedSetsCount is number && data.completedSetsCount >= 0 && data.completedSetsCount <= 300
        && isValidOptionalString(data, 'notes', 800)
        && data.entries is list && data.entries.size() <= 30
        && (data.entries.size() == 0 || data.entries[0] is map)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBodyMeasurement(data, userId) {
      return data.keys().hasAll(['ownerId', 'recordedDate', 'weightKg', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'ownerId', 'recordedDate', 'weightKg', 'bodyFatPct',
          'chestCm', 'waistCm', 'hipsCm', 'armsCm', 'thighsCm', 'notes',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.recordedDate is string && data.recordedDate.size() == 10 && data.recordedDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.weightKg is number && data.weightKg >= 20 && data.weightKg <= 400
        && isValidOptionalNumber(data, 'bodyFatPct', 2, 70)
        && isValidOptionalNumber(data, 'chestCm', 40, 220)
        && isValidOptionalNumber(data, 'waistCm', 35, 220)
        && isValidOptionalNumber(data, 'hipsCm', 40, 220)
        && isValidOptionalNumber(data, 'armsCm', 15, 90)
        && isValidOptionalNumber(data, 'thighsCm', 25, 130)
        && isValidOptionalString(data, 'notes', 500)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProgressReport(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'title', 'timeframeLabel', 'startDate', 'endDate',
          'workoutsCount', 'totalVolumeKg', 'weightDeltaKg', 'topMuscleGroup',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'title', 'timeframeLabel', 'startDate', 'endDate',
          'workoutsCount', 'totalVolumeKg', 'weightDeltaKg', 'topMuscleGroup', 'notes',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 120
        && data.timeframeLabel is string && data.timeframeLabel.size() >= 1 && data.timeframeLabel.size() <= 40
        && data.startDate is string && data.startDate.size() == 10 && data.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.endDate is string && data.endDate.size() == 10 && data.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.workoutsCount is number && data.workoutsCount >= 0 && data.workoutsCount <= 5000
        && data.totalVolumeKg is number && data.totalVolumeKg >= 0 && data.totalVolumeKg <= 10000000
        && data.weightDeltaKg is number && data.weightDeltaKg >= -200 && data.weightDeltaKg <= 200
        && data.topMuscleGroup is string && data.topMuscleGroup.size() >= 1 && data.topMuscleGroup.size() <= 32
        && isValidOptionalString(data, 'notes', 800)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Device-scoped UI View Options (non-PII theme & language for Login View)
    match /appOptions/{clientId} {
      allow get: if isValidId(clientId);
      allow list: if false;
      allow create: if isValidId(clientId)
        && isValidAppViewOptions(incoming(), clientId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(clientId)
        && isValidAppViewOptions(incoming(), clientId)
        && incoming().clientId == existing().clientId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['language', 'theme', 'updatedAt']);
      allow delete: if false;
    }

    // Non-PII Account Registry (verified before login)
    match /accountIndex/{emailHash} {
      allow get: if isValidEmailHash(emailHash);
      allow list: if false;
      allow create: if isValidEmailHash(emailHash)
        && isSignedIn()
        && isValidAccountIndexEntry(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidEmailHash(emailHash)
        && isSignedIn()
        && isOwner(existing().ownerId)
        && isValidAccountIndexEntry(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isValidEmailHash(emailHash) && isOwner(existing().ownerId);
    }

    // Structured User Account Root (ownership, status & biometrics)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserAccountRoot(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserAccountRoot(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().status == existing().status
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['heightCm', 'targetWeightKg', 'updatedAt']);
      allow delete: if isValidId(userId) && isOwner(userId);

      // Isolated PII
      match /private/{infoId} {
        allow get: if isValidId(userId) && infoId == 'info' && isOwner(userId);
        allow list: if false;
        allow create: if isValidId(userId)
          && infoId == 'info'
          && isOwner(userId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasValidParentProfile(userId);
        allow update: if isValidId(userId)
          && infoId == 'info'
          && isOwner(userId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'updatedAt'])
          && hasValidParentProfile(userId);
        allow delete: if isValidId(userId) && infoId == 'info' && isOwner(userId);
      }

      // Structured User Settings & Display Preferences
      match /settings/{settingId} {
        allow get: if isValidId(userId) && settingId == 'preferences' && isOwner(userId);
        allow list: if false;
        allow create: if isValidId(userId)
          && settingId == 'preferences'
          && isOwner(userId)
          && isValidUserViewSettings(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasValidParentProfile(userId);
        allow update: if isValidId(userId)
          && settingId == 'preferences'
          && isOwner(userId)
          && isValidUserViewSettings(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['goal', 'preferredUnit', 'language', 'theme', 'updatedAt'])
          && hasValidParentProfile(userId);
        allow delete: if isValidId(userId) && settingId == 'preferences' && isOwner(userId);
      }

      // Structured User Stats Summary
      match /stats/{statId} {
        allow get: if isValidId(userId) && statId == 'summary' && isOwner(userId);
        allow list: if false;
        allow create: if isValidId(userId)
          && statId == 'summary'
          && isOwner(userId)
          && isValidUserStatsSummary(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasValidParentProfile(userId);
        allow update: if isValidId(userId)
          && statId == 'summary'
          && isOwner(userId)
          && isValidUserStatsSummary(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'totalWorkouts', 'totalVolumeKg', 'totalCompletedSets',
            'latestWeightKg', 'latestMeasurementDate', 'updatedAt'
          ])
          && hasValidParentProfile(userId);
        allow delete: if isValidId(userId) && statId == 'summary' && isOwner(userId);
      }

      // Custom Exercises
      match /exercises/{exerciseId} {
        allow get: if isValidId(userId) && isValidId(exerciseId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(exerciseId)
          && isOwner(userId)
          && isValidCustomExercise(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasValidParentProfile(userId);
        allow update: if isValidId(userId)
          && isValidId(exerciseId)
          && isOwner(userId)
          && isValidCustomExercise(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['nameEn', 'nameAr', 'muscleGroup', 'equipment', 'trackingType', 'notes', 'updatedAt'])
          && hasValidParentProfile(userId);
        allow delete: if isValidId(userId) && isValidId(exerciseId) && isOwner(userId);
      }

      // Workout Routines
      match /routines/{routineId} {
        allow get: if isValidId(userId) && isValidId(routineId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(routineId)
          && isOwner(userId)
          && isValidWorkoutRoutine(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasValidParentProfile(userId);
        allow update: if isValidId(userId)
          && isValidId(routineId)
          && isOwner(userId)
          && isValidWorkoutRoutine(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'goal', 'estimatedMinutes', 'notes', 'exercises', 'updatedAt'])
          && hasValidParentProfile(userId);
        allow delete: if isValidId(userId) && isValidId(routineId) && isOwner(userId);
      }

      // Workout Sessions
      match /workouts/{workoutId} {
        allow get: if isValidId(userId) && isValidId(workoutId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(workoutId)
          && isOwner(userId)
          && isValidWorkoutSession(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasValidParentProfile(userId);
        allow update: if isValidId(userId)
          && isValidId(workoutId)
          && isOwner(userId)
          && isValidWorkoutSession(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'routineId', 'startedAtIso', 'completedAtIso', 'durationMinutes', 'totalVolumeKg', 'completedSetsCount', 'notes', 'entries', 'updatedAt'])
          && hasValidParentProfile(userId);
        allow delete: if isValidId(userId) && isValidId(workoutId) && isOwner(userId);
      }

      // Body Measurements
      match /measurements/{measurementId} {
        allow get: if isValidId(userId) && isValidId(measurementId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(measurementId)
          && isOwner(userId)
          && isValidBodyMeasurement(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasValidParentProfile(userId);
        allow update: if isValidId(userId)
          && isValidId(measurementId)
          && isOwner(userId)
          && isValidBodyMeasurement(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['recordedDate', 'weightKg', 'bodyFatPct', 'chestCm', 'waistCm', 'hipsCm', 'armsCm', 'thighsCm', 'notes', 'updatedAt'])
          && hasValidParentProfile(userId);
        allow delete: if isValidId(userId) && isValidId(measurementId) && isOwner(userId);
      }

      // Progress Reports
      match /progressReports/{reportId} {
        allow get: if isValidId(userId) && isValidId(reportId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(reportId)
          && isOwner(userId)
          && isValidProgressReport(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasValidParentProfile(userId);
        allow update: if isValidId(userId)
          && isValidId(reportId)
          && isOwner(userId)
          && isValidProgressReport(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'timeframeLabel', 'startDate', 'endDate', 'workoutsCount', 'totalVolumeKg', 'weightDeltaKg', 'topMuscleGroup', 'notes', 'updatedAt'])
          && hasValidParentProfile(userId);
        allow delete: if isValidId(userId) && isValidId(reportId) && isOwner(userId);
      }
    }
  }
}
